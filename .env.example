# Mission Control Environment Variables

# GitHub API (for PR fetching)
GITHUB_TOKEN=ghp_your_personal_access_token

# OpenClaw home directory — root of the .openclaw installation on the VPS.
# Required: all API routes and scripts construct paths relative to this.
# Example: OPENCLAW_HOME=/home/neg0/.openclaw
OPENCLAW_HOME=/home/neg0/.openclaw

# OpenClaw Gateway (for Kick to Rocket)
OPENCLAW_GATEWAY_URL=http://localhost:18789
OPENCLAW_HOOKS_TOKEN=your_hooks_token

# Optional: Restrict file browser root
OPENCLAW_WORKSPACE_ROOT=/home/neg0/.openclaw/workspace

# CarPlay Authentication
CARPLAY_JWT_SECRET=change_me_to_a_random_256_bit_secret
CARPLAY_DEVICE_SECRET=change_me_to_a_shared_pairing_secret
